# Copy to .env and replace each YOUR_... placeholder before deploying.
AWS_REGION=eu-north-1
AWS_ACCOUNT_ID=YOUR_AWS_ACCOUNT_ID
EMISSIONS_BUCKET_NAME=YOUR_EMISSIONS_BUCKET_NAME # Where you're storing the final emissions data output queried by the website
CUR_BUCKET_NAME=YOUR_CUR_BUCKET_NAME # Where your billing report is configured to output to
CUR_DATA_PREFIX=YOUR_CUR_DATA_PREFIX # anything directory prefixes between the bucket name, and "/data/BILLING_PERIOD=*/*"
GREENPIXIE_SECRET_ARN=YOUR_GREENPIXIE_SECRET_ARN # looks like arn:aws:secretsmanager:eu-north-1:123456789012:secret:YOUR_GREENPIXIE_SECRET_ARN
CUR_MAX_BYTES=67108864
IS_DEMO=false # Use live billing data, or demo data stored in the demo bucket instead. Demo bucket is created with the stack, but will need data added manually.
SITE_DOMAIN_NAME=yourdomain.com # The domain name you want to use for the website. Must be a domain you own!
CLOUDFRONT_CERTIFICATE_ARN=arn:aws:acm:us-east-1:ACCOUNT_ID:certificate/CERTIFICATE_ID